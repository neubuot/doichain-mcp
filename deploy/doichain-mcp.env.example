# Doichain MCP server configuration (EnvironmentFile of the systemd unit).
# REST API the server talks to. Local API next to your node, or the public one for read-only use.
DOI_MCP_API_URL=http://127.0.0.1:8080
# Public base URL of this instance (used for the icon and website links in serverInfo)
DOI_MCP_PUBLIC_URL=https://mcp.example.org
# Verification page linked in results
DOI_MCP_VERIFILE_URL=https://verifile.it
# API key with the "poe" tier for public anchoring (daily quota per client IP). Leave empty to disable anchoring.
DOI_MCP_POE_KEY=
# Host header values accepted by the server (DNS rebinding protection). Add every public hostname.
DOI_MCP_ALLOWED_HOSTS=mcp.example.org,127.0.0.1:*,localhost:*
# Interpret "Authorization: Bearer <token>" as a Doichain API key (default false). Only enable it when this
# server talks to your own REST API, otherwise tokens of other services would be forwarded to that API.
DOI_MCP_ACCEPT_BEARER=false
# Origin header values accepted when a client sends one
DOI_MCP_ALLOWED_ORIGINS=https://mcp.example.org,https://claude.ai,https://chatgpt.com,http://localhost:*,http://127.0.0.1:*
